{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "serve",
            "type": "shell",
            "command": "python3 -m http.server 5500",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^unused$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^unused-begin$",
                    "endsPattern": "Serving HTTP"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Open in Safari",
            "type": "shell",
            "command": "open -a Safari http://localhost:5500/index.html",
            "dependsOn": ["serve"],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
